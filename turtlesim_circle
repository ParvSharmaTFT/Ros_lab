
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist


class CircleTurtle(Node):

    def __init__(self):
        super().__init__('circle_turtle')

        self.publisher = self.create_publisher(
            Twist, '/turtle1/cmd_vel', 10
        )

        # Publish velocity every 0.1 seconds
        self.timer = self.create_timer(0.1, self.move_in_circle)

        self.get_logger().info('Turtle is moving in a circle!')

    def move_in_circle(self):
        msg = Twist()

        # Linear velocity
        msg.linear.x = 2.0

        # Angular velocity
        msg.angular.z = 1.0

        self.publisher.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = CircleTurtle()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        stop = Twist()
        node.publisher.publish(stop)
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
